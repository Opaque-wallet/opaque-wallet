      "text": "beforeRemoveLiquidity · bit 9\nhookData: a FORS+C signature\nPQKeyRegistry.consume\nrecipient → transient storage",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
