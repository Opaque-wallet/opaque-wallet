      "locked": false,
      "text": "Q-Day: what a quantum computer does to Ethereum",
      "fontSize": 40,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q-Day: what a quantum computer does to Ethereum",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0-cROLBmJZHw4s4q3acMY",
      "type": "text",
      "x": 40,
      "y": 78,
      "width": 1174.7591552734375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 36566480,
      "version": 2,
      "versionNonce": 1434381616,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793982336694,
      "link": null,
      "locked": false,
      "text": "Every account that has signed has published its public key. Shor's algorithm turns a public key back into its private key.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every account that has signed has published its public key. Shor's algorithm turns a public key back into its private key.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jruKJf-mkx0QqXrLZVrzu",
      "type": "text",
      "x": 40,
      "y": 106,
      "width": 755.439453125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 2016481072,
      "version": 2,
      "versionNonce": 2014690768,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793982336694,
      "link": null,
      "locked": false,
      "text": "Harvest now, decrypt later: on a public chain, everything is already harvested.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Harvest now, decrypt later: on a public chain, everything is already harvested.",
      "autoResize": true,
      "lineHeight": 1.25
    },
