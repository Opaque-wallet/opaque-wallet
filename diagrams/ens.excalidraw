    {
      "id": "UcAQV4f-kRAb1jiwrqX_k",
      "type": "text",
      "x": 1181.2641143798828,
      "y": 510,
      "width": 297.4717712402344,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
