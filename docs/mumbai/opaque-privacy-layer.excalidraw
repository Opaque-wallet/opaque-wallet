  },
  {
   "id": "te10",
   "type": "text",
   "x": 1234,
   "y": 149.75,
   "width": 399.84000000000003,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g8"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1800276390,
   "version": 1,
   "versionNonce": 1705890959,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "Proof + recipient + nullifier are sealed together\nto the attester's ML-KEM-768 key\nThat key is published in the signed relay directory\nOnly the attester can open it\n(a Chainlink CRE enclave on Arc)",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Proof + recipient + nullifier are sealed together\nto the attester's ML-KEM-768 key\nThat key is published in the signed relay directory\nOnly the attester can open it\n(a Chainlink CRE enclave on Arc)",
   "autoResize": true,
   "lineHeight": 1.25
  },
