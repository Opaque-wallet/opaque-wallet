   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "4 \u00b7 Relay mesh: three hops",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4 \u00b7 Relay mesh: three hops",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "te13",
   "type": "text",
   "x": 1234,
   "y": 389.75,
   "width": 439.04,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g11"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1096858888,
   "version": 1,
   "versionNonce": 463285151,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "Each hop: ML-KEM-768 + AES-256-GCM, no elliptic curve\nA random id per hop: relays can't join their logs\nPadded to 4, 16 or 64 KiB: payments look like queries\nThe 1.1 MiB spend goes as ~35 chunks, each on a new path\nWallet reads (balances, rings) take the same route",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each hop: ML-KEM-768 + AES-256-GCM, no elliptic curve\nA random id per hop: relays can't join their logs\nPadded to 4, 16 or 64 KiB: payments look like queries\nThe 1.1 MiB spend goes as ~35 chunks, each on a new path\nWallet reads (balances, rings) take the same route",
   "autoResize": true,
   "lineHeight": 1.25
  },
