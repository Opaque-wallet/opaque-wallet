   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2 \u00b7 Prove on your device",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "te7",
   "type": "text",
   "x": 644,
   "y": 149.75,
   "width": 439.04,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g5"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1006689997,
   "version": 1,
   "versionNonce": 72943345,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "Pick 7 other deposits of the same size: a ring of 8\nProve you know the secret behind one of them\nZKBoo: hash-based, so post-quantum \u00b7 1.08 MiB\nNullifier = your secret + the pool, never the recipient,\nso each note can be spent exactly once",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Pick 7 other deposits of the same size: a ring of 8\nProve you know the secret behind one of them\nZKBoo: hash-based, so post-quantum \u00b7 1.08 MiB\nNullifier = your secret + the pool, never the recipient,\nso each note can be spent exactly once",
   "autoResize": true,
   "lineHeight": 1.25
  },
