   "versionNonce": 978998438,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "What it does not hide, and what it trusts",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What it does not hide, and what it trusts",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "te34",
   "type": "text",
   "x": 54,
   "y": 838.5,
   "width": 1042.72,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g32"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 411964128,
   "version": 1,
   "versionNonce": 460153217,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "Not hidden: who deposits, note sizes, timing, and (until stealth addresses) the recipient.\nTrusted: the attester, for proof soundness, since a 1.08 MiB proof can't be checked on chain. One operator runs all six relays today.\nThe mesh hides you from relays that see some of the hops, not from a global observer or from all relays colluding.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not hidden: who deposits, note sizes, timing, and (until stealth addresses) the recipient.\nTrusted: the attester, for proof soundness, since a 1.08 MiB proof can't be checked on chain. One operator runs all six relays today.\nThe mesh hides you from relays that see some of the hops, not from a global observer or from all relays colluding.",
   "autoResize": true,
   "lineHeight": 1.25
  },
