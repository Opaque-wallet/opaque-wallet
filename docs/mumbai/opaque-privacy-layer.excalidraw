  },
  {
   "id": "te28",
   "type": "text",
   "x": 54,
   "y": 619.75,
   "width": 546.0,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g26"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 736579080,
   "version": 1,
   "versionNonce": 2074253065,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "Entry relay: your IP, not what you sent\nMiddle relay: only where to pass it next\nExit relay: a sealed blob, not who sent it\nAttester: which note and which recipient, not who you are\nAnyone on chain: 8 possible depositors, the recipient, the amount\nYour device: everything, and nothing leaves it unsealed",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Entry relay: your IP, not what you sent\nMiddle relay: only where to pass it next\nExit relay: a sealed blob, not who sent it\nAttester: which note and which recipient, not who you are\nAnyone on chain: 8 possible depositors, the recipient, the amount\nYour device: everything, and nothing leaves it unsealed",
   "autoResize": true,
   "lineHeight": 1.25
  },
