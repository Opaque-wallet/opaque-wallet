   "text": "1 \u00b7 Deposit (public)",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1 \u00b7 Deposit (public)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "te4",
   "type": "text",
   "x": 54,
   "y": 149.75,
   "width": 431.20000000000005,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g2"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1786268124,
   "version": 1,
   "versionNonce": 195586784,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "USDC becomes notes of 1, 2, 5, 10, 20, 50 or 100\nEach size has its own pool (PrivatePool)\nA deposit records a commitment, not an owner\nThe pool keeps no balances: a note is a secret you hold\nSeen on chain: who deposited, and how much",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "USDC becomes notes of 1, 2, 5, 10, 20, 50 or 100\nEach size has its own pool (PrivatePool)\nA deposit records a commitment, not an owner\nThe pool keeps no balances: a note is a secret you hold\nSeen on chain: who deposited, and how much",
   "autoResize": true,
   "lineHeight": 1.25
  },
