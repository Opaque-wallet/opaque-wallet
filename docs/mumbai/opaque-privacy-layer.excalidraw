   "updated": 1793836800000,
   "link": null,
   "locked": false,
   "text": "Opens the sealed spend and checks the ring proof,\nwhich is too big to verify on chain\nSigns the result with its FORS+C key\n32 uses per key, enforced by PQKeyRegistry\nSees which note and recipient, never your IP",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Opens the sealed spend and checks the ring proof,\nwhich is too big to verify on chain\nSigns the result with its FORS+C key\n32 uses per key, enforced by PQKeyRegistry\nSees which note and recipient, never your IP",
   "autoResize": true,
   "lineHeight": 1.25
  },
