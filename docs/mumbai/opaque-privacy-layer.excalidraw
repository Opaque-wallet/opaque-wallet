   "link": null,
   "locked": false,
   "text": "PrivatePool + AttestedRingVerifier check that\nall 8 ring members are real deposits,\nthe nullifier is unused and the FORS+C signature is valid\nThen one note's amount goes to the recipient\nWhoever submits the transaction authorizes nothing",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PrivatePool + AttestedRingVerifier check that\nall 8 ring members are real deposits,\nthe nullifier is unused and the FORS+C signature is valid\nThen one note's amount goes to the recipient\nWhoever submits the transaction authorizes nothing",
   "autoResize": true,
   "lineHeight": 1.25
  },
