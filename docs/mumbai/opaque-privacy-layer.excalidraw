  {
   "id": "te33",
   "type": "text",
   "x": 54,
   "y": 810,
   "width": 413.28000000000003,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
