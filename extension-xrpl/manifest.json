{
  "manifest_version": 3,
  "name": "Opaque for XRPL",
  "version": "0.3.0",
  "description": "A private XRPL wallet in your browser: notes in a shared pool, an account per app. Dapps that support GemWallet or Crossmark open Opaque instead. XRPL testnet.",
  "action": {
    "default_title": "Open Opaque"
  },
  "side_panel": {
    "default_path": "xrpl.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["sidePanel"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["xrpl-connect.html"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
