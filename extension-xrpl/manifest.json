{
  "manifest_version": 3,
  "name": "Opaque for XRPL",
  "version": "0.1.0",
  "description": "Private XRPL accounts, one per app. Dapps that support GemWallet or Crossmark open Opaque instead. XRPL testnet.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
